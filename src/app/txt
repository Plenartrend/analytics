    G = build_speech_graph(speeches, min_similarity=0.40)
    plt.figure(figsize=(12, 10))
    pos = nx.spring_layout(G, k=0.8, seed=42)
    nx.draw_networkx_nodes(G, pos, node_color="lightblue", node_size=1200)
    labels = {
        n: f"Id: {speeches[n].id}\n" + "\n".join(speeches[n].topics[:2])
        for n in G.nodes()
    }
    nx.draw_networkx_labels(G, pos, labels=labels, font_size=7)
    # Weighted edges (thicker = more similar)
    edges = G.edges(data=True)
    nx.draw_networkx_edges(
        G,
        pos,
        edgelist=[(u, v) for u, v, _ in edges],
        width=[d["weight"] * 4 for _, _, d in edges],
    )
    plt.title("Speech-to-Speech Topic Similarity Graph")
    plt.axis("off")
    plt.show()

